APP_NAME=Lucidex API
ENV=development
API_V1_PREFIX=/api/v1

MONGODB_URI=mongodb+srv://<USERNAME>:<PASSWORD>@lucidexserver.ooqpjuu.mongodb.net/?appName=LucidexServer
MONGODB_DB_NAME=lucidex-01

EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=...
EMAIL_SMTP_PASSWORD=...

JWT_SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

REDIS_URL=redis://localhost:6379/0
CORS_ALLOWED_ORIGINS=http://localhost:5173

EKYC_MOCK_MODE=true
FILE_STORAGE_BACKEND=local
FILE_STORAGE_PATH=./uploads
