APP_NAME=Lucidex API
ENV=development
API_V1_PREFIX=/api/v1

MONGODB_URI=mongodb+srv://<USERNAME>:<PASSWORD>@lucidexserver.ooqpjuu.mongodb.net/?appName=LucidexServer
MONGODB_DB_NAME=lucidex-01

EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=...
EMAIL_SMTP_PASSWORD=...

JWT_SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

GOOGLE_CLIENT_ID=

FIRST_SUPERADMIN_USERNAME=
FIRST_SUPERADMIN_PASSWORD_HASH=

REDIS_URL=redis://localhost:6379/0
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Local default; staging/production must use the public frontend URL.
FRONTEND_BASE_URL=http://localhost:5173

EKYC_MOCK_MODE=true
FILE_STORAGE_BACKEND=local
FILE_STORAGE_PATH=./uploads
GCS_PROJECT_ID=lucidex-502504
GCS_BUCKET_NAME=<bucket-name>
